.feed-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 4fr 1fr;
    grid-rows: 4fr 1fr;
    height: 1fr;
}

.feed-messages {
    border: green;
    column-span: 2;
    background: black;
    height: 100%;
}

.feed-log {
    border: darkgreen;
    background: black;
}

.feed-status {
    border: greenyellow;
}

.feed-status-container {
    layout: grid;
    grid-size: 1;
    grid-rows: 4fr 1fr;
}

.feed-mps {
    height: auto;
}

.sdr-controls {
    height: 3;
    align: left middle;
}

.sdr-profile-status {
    height: auto;
    padding: 0 1;
}

.sdr-controls > Button {
    margin-right: 1;
}

HelpScreen, FilterScreen {
    align: center middle;
}

#help {
    padding: 0 1;
    width: 70%;
    height: 70%;
    border: thick solid yellow;
    overflow-y: auto;
    background: $boost;
}

#filter {
    width: 50%;
    border: thick solid yellow;
}

AboutScreen {
    align: center middle;
}

#about {
    width: 90%;
    max-width: 120;
    height: auto;
    max-height: 90%;
    border: thick solid yellow;
    background: $boost;
    padding: 1 2;
}

#about-title, #about-version {
    width: 1fr;
    text-align: center;
}

#about-title {
    text-style: bold;
}

#app-versions {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 1 2;
    height: auto;
}

#app-versions.single-column {
    grid-size: 1;
    grid-columns: 1fr;
}

.app-version-section {
    width: 1fr;
    height: auto;
}

.app-version-title {
    width: 1fr;
    text-style: bold;
}

.app-version-path {
    width: 1fr;
    height: auto;
}

Rule {
    color: goldenrod;
}

.column {
    width: 50%;
    height: auto;
}

SaveScreen {
    align: center middle;
}

#save-dialog {
    width: 50%;
    height: auto;
    border: thick solid yellow;
    background: $boost;
    padding: 1 2;
}

#save-dialog > Label {
    margin: 0 0 1 0;
}

#save-filename {
    margin: 0 0 1 0;
}

#save-format {
    margin: 0 0 1 0;
}

#save-buttons {
    align: center middle;
    height: auto;
}

#save-buttons > Button {
    margin: 0 1;
}

ProfilesScreen, ProfileEditorScreen, ProfileDeleteScreen {
    align: center middle;
}

#profiles-dialog, #profile-editor, #profile-delete-dialog {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: thick solid yellow;
    background: $boost;
    padding: 0 1;
}

#profile-list {
    height: 1fr;
    min-height: 3;
}

#profiles-dialog {
    height: 20;
}

#profile-fields {
    height: 1fr;
    min-height: 3;
}

#profile-editor {
    height: 23;
}

#profile-error, #profile-notice, #profile-effective {
    height: auto;
    max-height: 3;
}

.profile-buttons {
    height: 3;
}

.profile-buttons > Button {
    min-width: 10;
    width: 1fr;
}
